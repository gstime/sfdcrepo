<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Case_creation_email_notification</fullName>
        <ccEmails>show.goutam.sfdc@gmail.com</ccEmails>
        <description>Case creation email notification</description>
        <protected>false</protected>
        <recipients>
            <recipient>show.goutam.sfdc@gmail.com</recipient>
            <type>user</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/SchedulerUnauthenticatedUserAppointmentTypeEmailTemplateForAmazonChime</template>
    </alerts>
    <alerts>
        <fullName>Success_entitlement_sla</fullName>
        <ccEmails>show.goutam@gmail.com</ccEmails>
        <description>Success entitlement sla</description>
        <protected>false</protected>
        <recipients>
            <recipient>show.goutam.sfdc@gmail.com</recipient>
            <type>user</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/SupportCaseResponse</template>
    </alerts>
    <alerts>
        <fullName>Violation_entitlement_action</fullName>
        <ccEmails>show.goutam@gmail.com</ccEmails>
        <description>Violation entitlement action</description>
        <protected>false</protected>
        <recipients>
            <recipient>show.goutam.sfdc@gmail.com</recipient>
            <type>user</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/SupportEscalatedCaseNotification</template>
    </alerts>
    <alerts>
        <fullName>Worning_entitlement_action</fullName>
        <ccEmails>show.goutam@gmail.com</ccEmails>
        <description>Worning entitlement action</description>
        <protected>false</protected>
        <recipients>
            <recipient>show.goutam.sfdc@gmail.com</recipient>
            <type>user</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/SupportEscalatedCaseReassignment</template>
    </alerts>
    <fieldUpdates>
        <fullName>ChangePriorityToHigh</fullName>
        <field>Priority</field>
        <literalValue>High</literalValue>
        <name>Changes the case priority to high.</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Update_Case_Flag_To_Warning</fullName>
        <field>Priority</field>
        <literalValue>High</literalValue>
        <name>Update Case Flag To Warning</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
    </fieldUpdates>
    <rules>
        <fullName>TestWorkflow</fullName>
        <actions>
            <name>Update_Case_Flag_To_Warning</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>equals</operation>
            <value>Closed</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <offsetFromField>Case.ClosedDate</offsetFromField>
            <timeLength>48</timeLength>
            <workflowTimeTriggerUnit>Hours</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
</Workflow>
